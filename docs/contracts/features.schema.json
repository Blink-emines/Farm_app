{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://farm-app.local/contracts/features.schema.json",
  "title": "Features",
  "description": "Climate and soil features for one lat/lon point in the Saïss pilot region. Produced by data/ (data-engineer) via data.pipeline.get_features(); consumed by engine/ and returned as-is by GET /api/features. Every series records its unit, its source and how it was derived.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "location", "climate", "soil", "data_gaps", "sources"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "generated_at": { "type": "string", "format": "date-time" },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latitude", "longitude", "elevation_m", "region"],
      "properties": {
        "latitude": { "type": "number", "minimum": -90, "maximum": 90, "description": "Decimal degrees, rounded to 2 decimals." },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180, "description": "Decimal degrees, rounded to 2 decimals." },
        "elevation_m": { "type": ["number", "null"], "description": "Metres above sea level as reported by NASA POWER; null if not reported." },
        "region": { "enum": ["saiss", "morocco"], "description": "\"morocco\" from 2026-11-14 (whole-country scope); \"saiss\" accepted during the transition." }
      }
    },
    "climate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["period", "monthly"],
      "properties": {
        "period": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start_year", "end_year"],
          "description": "Complete calendar years averaged into the monthly climatology (20 years for the MVP).",
          "properties": {
            "start_year": { "type": "integer", "minimum": 1981 },
            "end_year": { "type": "integer", "minimum": 1981 }
          }
        },
        "monthly": {
          "type": "object",
          "additionalProperties": false,
          "description": "12-value monthly climatology, January first. Each value is the average over the period.",
          "required": [
            "t2m_mean", "t2m_max", "t2m_min", "precipitation", "et0", "water_balance",
            "rh2m", "ws2m", "solar_radiation", "root_zone_wetness", "frost_days", "heat_days"
          ],
          "properties": {
            "t2m_mean": { "allOf": [{ "$ref": "#/$defs/series" }, { "properties": { "unit": { "const": "°C" } } }], "description": "Mean air temperature at 2 m." },
            "t2m_max": { "allOf": [{ "$ref": "#/$defs/series" }, { "properties": { "unit": { "const": "°C" } } }], "description": "Mean of daily maximum air temperature at 2 m." },
            "t2m_min": { "allOf": [{ "$ref": "#/$defs/series" }, { "properties": { "unit": { "const": "°C" } } }], "description": "Mean of daily minimum air temperature at 2 m." },
            "precipitation": { "allOf": [{ "$ref": "#/$defs/series" }, { "properties": { "unit": { "const": "mm/month" } } }], "description": "Monthly rainfall total (bias-corrected)." },
            "et0": { "allOf": [{ "$ref": "#/$defs/series" }, { "properties": { "unit": { "const": "mm/month" } } }], "description": "Reference evapotranspiration, FAO-56 Penman-Monteith, summed per month." },
            "water_balance": { "allOf": [{ "$ref": "#/$defs/series" }, { "properties": { "unit": { "const": "mm/month" } } }], "description": "precipitation minus et0. Negative = the month is drier than a reference crop needs." },
            "rh2m": { "allOf": [{ "$ref": "#/$defs/series" }, { "properties": { "unit": { "const": "%" } } }], "description": "Mean relative humidity at 2 m." },
            "ws2m": { "allOf": [{ "$ref": "#/$defs/series" }, { "properties": { "unit": { "const": "m/s" } } }], "description": "Mean wind speed at 2 m." },
            "solar_radiation": { "allOf": [{ "$ref": "#/$defs/series" }, { "properties": { "unit": { "const": "MJ/m²/day" } } }], "description": "Mean daily all-sky surface shortwave radiation." },
            "root_zone_wetness": { "allOf": [{ "$ref": "#/$defs/series" }, { "properties": { "unit": { "const": "0-1" } } }], "description": "Root-zone soil wetness, 0 = completely dry, 1 = saturated. Satellite/model estimate, not a field measurement." },
            "frost_days": { "allOf": [{ "$ref": "#/$defs/series" }, { "properties": { "unit": { "const": "days/month" } } }], "description": "Average number of days per month with daily minimum temperature below 0 °C." },
            "heat_days": {
              "type": "object",
              "additionalProperties": false,
              "required": ["30", "32", "35", "38"],
              "description": "Average number of days per month with daily maximum temperature above each threshold (°C). The engine uses the highest threshold that is not above a crop's own heat threshold, and says so.",
              "properties": {
                "30": { "allOf": [{ "$ref": "#/$defs/series" }, { "properties": { "unit": { "const": "days/month" } } }] },
                "32": { "allOf": [{ "$ref": "#/$defs/series" }, { "properties": { "unit": { "const": "days/month" } } }] },
                "35": { "allOf": [{ "$ref": "#/$defs/series" }, { "properties": { "unit": { "const": "days/month" } } }] },
                "38": { "allOf": [{ "$ref": "#/$defs/series" }, { "properties": { "unit": { "const": "days/month" } } }] }
              }
            }
          }
        }
      }
    },
    "soil": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "source", "layers"],
      "description": "SoilGrids properties converted to conventional units. Status says where the values came from.",
      "properties": {
        "status": {
          "enum": ["live", "cache", "fallback", "unavailable"],
          "description": "live = fetched now; cache = stored earlier response; fallback = data/fallback/saiss_soil.json (a saved real SoilGrids response, never hand-typed); unavailable = no soil data (layers is empty and data_gaps explains it)."
        },
        "source": { "type": ["string", "null"], "description": "id of an entry in sources; null when unavailable." },
        "layers": {
          "type": "array",
          "maxItems": 3,
          "items": { "$ref": "#/$defs/soilLayer" }
        }
      }
    },
    "yearly": {
      "type": "object",
      "additionalProperties": false,
      "required": ["years", "precipitation", "et0", "water_balance", "frost_days", "heat_days_35", "precipitation_monthly", "source", "method"],
      "description": "Year-by-year values for the 20-year time machine (added 2026-11-14, user-approved). All arrays are aligned with years.",
      "properties": {
        "years": { "type": "array", "minItems": 1, "items": { "type": "integer" } },
        "precipitation": { "$ref": "#/$defs/yearValues", "description": "Annual rain total, mm/year." },
        "et0": { "$ref": "#/$defs/yearValues", "description": "Annual reference evapotranspiration, mm/year." },
        "water_balance": { "$ref": "#/$defs/yearValues", "description": "precipitation minus et0, mm/year." },
        "frost_days": { "$ref": "#/$defs/yearValues", "description": "Days with Tmin < 0 °C, days/year." },
        "heat_days_35": { "$ref": "#/$defs/yearValues", "description": "Days with Tmax > 35 °C, days/year." },
        "precipitation_monthly": { "type": "array", "items": { "$ref": "#/$defs/monthValues" }, "description": "One 12-value array of monthly rain (mm/month) per year." },
        "source": { "type": "string" },
        "method": { "type": "string", "minLength": 1 }
      }
    },
    "vegetation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "source", "product", "period", "ndvi_monthly", "recent"],
      "description": "Satellite vegetation greenness (NDVI) for the point (added 2026-11-14, user-approved). status unavailable = no NDVI; values are then null and data_gaps explains it.",
      "properties": {
        "status": { "enum": ["live", "cache", "unavailable"] },
        "source": { "type": ["string", "null"], "description": "id of an entry in sources." },
        "product": { "type": "string", "description": "Exact product, e.g. \"MODIS MOD13Q1 NDVI, 250 m, 16-day\"." },
        "period": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["start_year", "end_year"],
          "properties": { "start_year": { "type": "integer" }, "end_year": { "type": "integer" } }
        },
        "ndvi_monthly": { "$ref": "#/$defs/monthValues", "description": "Average NDVI per month over the period, -1..1 (unitless)." },
        "recent": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["year", "values"],
          "properties": { "year": { "type": "integer" }, "values": { "$ref": "#/$defs/monthValues" } },
          "description": "Monthly NDVI of the most recent complete year."
        }
      }
    },
    "data_gaps": {
      "type": "array",
      "description": "Everything missing or uncertain, in plain words. Empty only if nothing is missing.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message", "affects"],
        "properties": {
          "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "message": { "type": "string", "minLength": 1 },
          "affects": { "type": "array", "items": { "type": "string" }, "description": "Feature paths affected, e.g. \"soil\" or \"climate.monthly.root_zone_wetness\"." }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "dataset", "url", "accessed_at", "cache_status"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "name": { "type": "string", "description": "e.g. \"NASA POWER\" or \"ISRIC SoilGrids\"." },
          "dataset": { "type": "string", "description": "Exact dataset/endpoint used, e.g. \"NASA POWER daily point API, community AG\"." },
          "url": { "type": "string", "format": "uri", "description": "Base URL of the endpoint (no cache key or query string needed)." },
          "accessed_at": { "type": "string", "format": "date-time", "description": "When the raw response was fetched (for cached data: the original fetch time)." },
          "cache_status": { "enum": ["live", "cache", "fallback"] }
        }
      }
    }
  },
  "$defs": {
    "yearValues": {
      "type": "array",
      "minItems": 1,
      "items": { "type": ["number", "null"] },
      "description": "One value per entry of yearly.years; null = no valid data that year."
    },
    "monthValues": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": { "type": ["number", "null"] },
      "description": "January..December. null = no valid data for that month (never a sentinel like -999)."
    },
    "series": {
      "type": "object",
      "additionalProperties": false,
      "required": ["values", "unit", "source", "method", "nasa_parameter"],
      "properties": {
        "values": { "$ref": "#/$defs/monthValues" },
        "unit": { "type": "string" },
        "source": { "type": "string", "description": "id of an entry in sources." },
        "method": { "type": "string", "minLength": 1, "description": "How the value was derived, e.g. \"monthly sum of daily PRECTOTCORR, averaged over period\"." },
        "nasa_parameter": { "type": ["string", "null"], "description": "Verified NASA POWER parameter name(s) used, or null for values computed only from other features." }
      }
    },
    "soilLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["depth", "clay_pct", "sand_pct", "silt_pct", "soc_g_kg", "ph_h2o"],
      "properties": {
        "depth": { "enum": ["0-5cm", "5-15cm", "15-30cm"] },
        "clay_pct": { "type": ["number", "null"], "minimum": 0, "maximum": 100, "description": "Clay content, % by mass." },
        "sand_pct": { "type": ["number", "null"], "minimum": 0, "maximum": 100, "description": "Sand content, % by mass." },
        "silt_pct": { "type": ["number", "null"], "minimum": 0, "maximum": 100, "description": "Silt content, % by mass." },
        "soc_g_kg": { "type": ["number", "null"], "minimum": 0, "description": "Soil organic carbon, g/kg." },
        "ph_h2o": { "type": ["number", "null"], "minimum": 0, "maximum": 14, "description": "Soil pH measured in water." }
      }
    }
  }
}
