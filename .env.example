# Copy this file to backend/.env and fill in real values.
# backend/.env is ignored by git — never commit it.

# Django secret key (used to sign login tokens). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me

# True only on your own computer, never on a public server
DJANGO_DEBUG=True

# Comma-separated hostnames allowed to serve the backend
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Optional: Supabase Postgres (session pooler URI, see docs/supabase-setup.md).
# Leave unset to use the local SQLite file backend/db.sqlite3.
# Percent-encode special characters in the password (@ -> %40, # -> %23, / -> %2F).
# DATABASE_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-eu-west-3.pooler.supabase.com:5432/postgres
